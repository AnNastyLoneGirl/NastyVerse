# Rust / Tauri build output
target/
**/target/

# Launcher copy generated by launcher/src-tauri/build.rs.
launcher/src/tokens.css

# The hosted app receives shared/tokens.css as tokens.css during installation.
# Keep accidental local copies out of Git so shared/tokens.css stays canonical.
app/src/tokens.css

# Local runtime/update data (must never become source files)
runtime/
update-staging/
update-backup/
user-data/

# Generated portable release artifacts
dist/
*.exe
*.msi
*.msix
*.sig

# Local signing material / environment files
*.key
*.key.pub
.env
.env.*

# Logs / temporary files
*.log
*.tmp
*.bak

# OS / IDE
.DS_Store
Thumbs.db
.vs/
.idea/
