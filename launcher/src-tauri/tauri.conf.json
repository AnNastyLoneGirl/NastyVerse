{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NastyVerse Launcher",
  "version": "0.1.1",
  "identifier": "com.nastyverse.launcher",
  "mainBinaryName": "NastyVerse-Launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NastyVerse Launcher",
        "width": 1160,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
